{
  "_comment": "Deterministic corpus manifest for verdict_equivalence.py. Probes are parametric geometry specs; fuzz entries are expanded into concrete specs with a seeded RNG so both trees see identical inputs. Prim spec shapes: box {p0,p1}, cyl {p,d,r,h}, sphere {c,r}, cone {p,d,r1,r2,h}, torus {R,r}; optional xform {rotate:[[x,y,z],angle_rad], translate:[x,y,z]}.",
  "version": 1,
  "probes": [
    {"name": "union: boxes sharing a full face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [1,1,1]},
     "B": {"prim": "box", "p0": [1,0,0], "p1": [2,1,1]}, "op": "union"},
    {"name": "union: boxes sharing a partial face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [1,1,1]},
     "B": {"prim": "box", "p0": [1,0.25,0.25], "p1": [2,0.75,0.75]}, "op": "union"},
    {"name": "union: offset box stacked on top",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "box", "p0": [0.5,0.5,2], "p1": [1.5,1.5,3]}, "op": "union"},
    {"name": "cut: slot flush with top face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "box", "p0": [0.5,-1,1], "p1": [1.5,3,2]}, "op": "difference"},
    {"name": "cut: pocket flush with top face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "box", "p0": [0.5,0.5,1], "p1": [1.5,1.5,2]}, "op": "difference"},
    {"name": "cut: slot overshooting top face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "box", "p0": [0.5,-1,1], "p1": [1.5,3,3]}, "op": "difference"},
    {"name": "cut: through-hole cylinder",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "cyl", "p": [1,1,-1], "d": [0,0,1], "r": 0.5, "h": 4},
     "op": "difference"},
    {"name": "cut: blind hole flush with top",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "cyl", "p": [1,1,1], "d": [0,0,1], "r": 0.5, "h": 1},
     "op": "difference"},
    {"name": "union: boss on top face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "cyl", "p": [1,1,2], "d": [0,0,1], "r": 0.5, "h": 1},
     "op": "union"},
    {"name": "common: sub-box sharing 3 faces",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "box", "p0": [0,0,0], "p1": [1,1,1]}, "op": "intersection"},
    {"name": "cut: corner notch sharing 3 faces",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "box", "p0": [1,1,1], "p1": [2,2,2]}, "op": "difference"},
    {"name": "union: crossing cylinders r1 != r2",
     "A": {"prim": "cyl", "p": [0,0,-2], "d": [0,0,1], "r": 1.0, "h": 4},
     "B": {"prim": "cyl", "p": [-2,0,0], "d": [1,0,0], "r": 0.6, "h": 4},
     "op": "union"},
    {"name": "union: crossing cylinders equal r (singular)",
     "A": {"prim": "cyl", "p": [0,0,-2], "d": [0,0,1], "r": 1.0, "h": 4},
     "B": {"prim": "cyl", "p": [-2,0,0], "d": [1,0,0], "r": 1.0, "h": 4},
     "op": "union"},
    {"name": "cut: sphere from box corner",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [2,2,2]},
     "B": {"prim": "sphere", "c": [2.1,1.3,0.9], "r": 0.8}, "op": "difference"},
    {"name": "union: boxes touching along one edge",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [1,1,1]},
     "B": {"prim": "box", "p0": [1,1,0], "p1": [2,2,1]}, "op": "union"},
    {"name": "common: boxes sharing only a face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [1,1,1]},
     "B": {"prim": "box", "p0": [1,0,0], "p1": [2,1,1]}, "op": "intersection"},
    {"name": "cut: tool sharing only a face",
     "A": {"prim": "box", "p0": [0,0,0], "p1": [1,1,1]},
     "B": {"prim": "box", "p0": [1,0,0], "p1": [2,1,1]}, "op": "difference"}
  ],
  "fuzz": [
    {"trials": 40, "seed": 5, "snap": 0.5, "kinds": ["box", "cyl"]},
    {"trials": 40, "seed": 7, "snap": 0.0, "kinds": ["box", "cyl", "sph"]}
  ]
}
